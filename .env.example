# QuantPilot AI environment template - copy to .env and fill in real values.
# NEVER commit real secrets (doc 21.3).

# --- remote server SSH (for scripts/dev_pg_tunnel.py / scripts/run_remote.py) ---
QP_HOST=192.168.11.138
QP_USER=ubuntu
QP_PASS=<ssh-password>

# --- PostgreSQL DSN (via SSH tunnel on 127.0.0.1:54322) ---
QP_PG_DSN=postgresql://quantpilot:<pg-password>@127.0.0.1:54322/quantpilot

# --- NATS (JetStream) ---
QP_NATS_URL=nats://quantpilot:<nats-password>@<nats-host>:4222

# --- cloud API ---
QP_API_BASE_URL=http://127.0.0.1:8000
QP_API_HOST=127.0.0.1
QP_API_PORT=8000
# service key for X-API-Key auth: the API refuses all /api/* traffic
# without it (fail-closed); the agent, sim_ea/e2e scripts and the Vite dev
# proxy all read it from here
# QP_API_KEY=<generate: python -c "import secrets;print(secrets.token_hex(24))">

# --- login throttling (R3.1 / R3.2) ---
# memory_only (default): per-instance in-process limiting (single API)
# redis_required: multi-instance shared counting via Redis; while Redis is
# unreachable password logins are REJECTED (503) - the API never silently
# degrades to per-instance counters an attacker could shard around
# R3.2 STRICT parsing: an UNKNOWN value (e.g. the typo 'redis_require') and
# redis_required without a URL both FAIL the startup - the service never
# silently falls back to memory_only
QP_LOGIN_THROTTLE_MODE=memory_only
# required when mode=redis_required; ignored (with a loud warning) otherwise
# QP_LOGIN_THROTTLE_REDIS_URL=redis://:password@redis-host:6379/0

# --- local agent ---
QP_AGENT_HOST=127.0.0.1
QP_AGENT_PORT=8787
# random 64-hex token, shared with the EA input AgentToken
QP_AGENT_TOKEN=<generate: python -c "import secrets;print(secrets.token_hex(32))">
# stable device uuid: python -c "import uuid;print(uuid.uuid4())"
QP_DEVICE_ID=<uuid4>
QP_AGENT_VERSION=0.1.0
